# 隐私配置（如你在此文件填了账号密码，切勿提交）
config.json

# 浏览器登录态 / cookie（含账号凭证，绝对不能提交）
storage_state.json

# Edge 浏览器用户配置目录（含登录凭证，体积巨大）
edge_profile/

# 调试输出
dashboard_dump.txt
*_dump.txt

# 日志
*.log
nas.log
keepalive.log

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境 / 依赖打包
venv/
.venv/
env/
*.egg-info/
.eggs/
build/
dist/

# Playwright 浏览器缓存
ms-playwright/

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# NAS 部署配置（含账号/路径等，绝不进公开仓库）
config_nas.json

# SSH 公钥种子（含授权信息，泄露等同于暴露 NAS 登录通道）
authorized_keys_seed.txt

# 调试快照 / 截图（含页面 DOM 与本地路径，非源码）
dbg_*
*.png
_*
